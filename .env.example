# Public site origin (no trailing slash). Used for canonical URLs, sitemap, OG, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Resend API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address in Resend (use onboarding@resend.dev for testing)
APPOINTMENT_FROM_EMAIL=onboarding@resend.dev

# Inbox that should receive appointment requests
APPOINTMENT_TO_EMAIL=appointments@yourdomain.com
